# ===== 爆款拆解 LLM 配置（服务端） =====
# 复制本文件为 server.env，填入你的密钥后保存（server.env 已被 .gitignore 忽略，不会进仓库）。
# 重启 server.js 后生效。支持任意 OpenAI 兼容接口（OpenAI / DeepSeek / 腾讯混元 等）。

# 必填：LLM API Key
LLM_API_KEY=

# 可选：接口地址（默认 OpenAI 官方）。DeepSeek 填 https://api.deepseek.com/v1
LLM_BASE_URL=https://api.openai.com/v1

# 可选：模型名（默认 gpt-4o-mini）。DeepSeek 用 deepseek-chat；混元用 hunyuan-pro
LLM_MODEL=gpt-4o-mini
